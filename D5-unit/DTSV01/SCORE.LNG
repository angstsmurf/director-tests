importFileInto member 10, "F:\BLOCK.BMP"
importFileInto member 11, "F:\DVE.MOV"
jobLog("type " & the type of member 11 & " file " & the fileName of member 11 & " rect " & the rect of member 11)
set the directToStage of member 11 to TRUE
set the loop of member 11 to TRUE
jobLog("dts " & the directToStage of member 11 & " loop " & the loop of member 11 & " stage " & the stageRight - the stageLeft & "x" & the stageBottom - the stageTop)
beginRecording
set the frameTempo to 15
set the member of sprite 3 to member 10
set the rect of sprite 3 to rect(-300, -300, -200, -200)
set the foreColor of sprite 3 to 35
set the member of sprite 4 to member 11
set the rect of sprite 4 to rect(200, 150, 456, 342)
set the member of sprite 5 to member 10
set the rect of sprite 5 to rect(-300, -300, -200, -200)
set the foreColor of sprite 5 to 210
updateFrame
set the frameTempo to 15
set the member of sprite 3 to member 10
set the rect of sprite 3 to rect(-300, -300, -200, -200)
set the foreColor of sprite 3 to 35
set the member of sprite 5 to member 10
set the rect of sprite 5 to rect(-300, -300, -200, -200)
set the foreColor of sprite 5 to 210
updateFrame
endRecording
